# Cursor indexing ignore patterns
# Bu dosyalar/klasörler Cursor'ın indexlemesinden hariç tutulur

# Node modules (çok büyük, indexlenmesine gerek yok)
node_modules/

# Python cache
__pycache__/
*.pyc
*.pyo

# Build outputs
build/
dist/
*.egg-info/

# Test coverage
coverage_html/
.coverage

# Database files
*.db
*.sqlite
*.sqlite3

# Vector stores (büyük binary dosyalar)
backend/data/vectors/*.index

# Uploaded files
backend/uploads/

# Virtual environments
venv/
env/
ENV/

# IDE
.vscode/
.idea/

# Logs
*.log
