# Frontend Environment Variables
# Copy this file to .env and update values as needed

# ============================================================================
# API Configuration
# ============================================================================

# Backend API Base URL
# Development: http://127.0.0.1:8000/v1
# Production: https://api.kampusplus.edu.tr/v1
VITE_API_URL=http://127.0.0.1:8000/v1

# ============================================================================
# Notes
# ============================================================================
# - All environment variables must be prefixed with VITE_ to be accessible
# - Changes to .env require a restart of the dev server
# - This file should NOT be committed to git (already in .gitignore)
# - For production, set these values in your deployment platform (Docker, Vercel, etc.)
