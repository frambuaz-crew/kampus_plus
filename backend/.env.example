# KAMPÜS+ Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME="KAMPÜS+ AI Platform"
APP_VERSION="0.1.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG=true

# ============================================================================
# DATABASE
# ============================================================================
# SQLite (development/testing)
DATABASE_URL=sqlite+aiosqlite:///./kampus_plus_dev.db

# PostgreSQL (production) - uncomment and configure when needed
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# POSTGRES_DB=kampus_plus
# POSTGRES_USER=kampus_user
# POSTGRES_PASSWORD=your_password_here
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# GOOGLE GEMINI API (REQUIRED)
# ============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
AI_PROVIDER=gemini
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=models/gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=8192

# ============================================================================
# AWS S3 (Document Storage) - Optional for development
# ============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-central-1
AWS_S3_BUCKET=kampus-plus-documents
S3_PRESIGNED_URL_EXPIRY_SECONDS=900

# ============================================================================
# FAISS VECTOR STORE
# ============================================================================
VECTOR_STORE_PATH=./data/vectors
FAISS_INDEX_OFFICIAL=kampus_official.index
FAISS_INDEX_USER=kampus_user.index
VECTOR_DIMENSION=1536
VECTOR_SEARCH_K=5

# ============================================================================
# PDF PROCESSING
# ============================================================================
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=pdf
PDF_CHUNK_SIZE=512
PDF_CHUNK_OVERLAP=50

# ============================================================================
# DATA SYNC (APScheduler)
# ============================================================================
SYNC_ENABLED=true
SYNC_INTERVAL_HOURS=2
SYNC_START_HOUR=8
SYNC_END_HOUR=22

# University Data Sources (customize per university)
UZEM_API_URL=https://uzem.example.edu.tr/api
UZEM_API_KEY=your_uzem_api_key_here
ANNOUNCEMENTS_RSS_URL=https://example.edu.tr/announcements/rss
SCHEDULE_CSV_URL=https://example.edu.tr/schedules/export.csv

# ============================================================================
# SECURITY
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=100
AI_RATE_LIMIT_PER_MINUTE=10

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================================================
# EMAIL (for verification/password reset) - Optional
# ============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@kampusplus.edu.tr
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_EMAIL=noreply@kampusplus.edu.tr
SMTP_FROM_NAME="KAMPÜS+ Platform"

# ============================================================================
# UNIVERSITY SPECIFIC
# ============================================================================
UNIVERSITY_NAME="Example University"
UNIVERSITY_EMAIL_DOMAIN=example.edu.tr
SUPPORT_EMAIL=support@kampusplus.edu.tr
