# KAMPÜS+ Environment Variables
# Bu dosyayı .env olarak kopyalayın ve gerçek değerlerinizi girin

# ============================================================================
# UYGULAMA
# ============================================================================
ENVIRONMENT=development  # development, staging, production
DEBUG=true

# ============================================================================
# VERİTABANI - PostgreSQL (asyncpg) Kullanılıyor ✅
# ============================================================================
# Format: postgresql+asyncpg://kullanıcı:şifre@host:port/veritabanı_adı
DATABASE_URL=postgresql+asyncpg://kampus:kampus@postgres:5432/kampus_plus

# ============================================================================
# JWT KİMLİK DOĞRULAMA
# ============================================================================
# Güvenli bir key oluşturmak için: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER_ME=30

# ============================================================================
# GOOGLE GEMINI API (GEREKLİ)
# ============================================================================
# API key almak için: https://makersuite.google.com/app/apikey
AI_PROVIDER=gemini
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=8192

# ============================================================================
# DOSYA DEPOLAMA - LOCAL STORAGE
# ============================================================================
# NOT: Bu proje LOCAL STORAGE kullanır (backend/uploads/).
# S3, MinIO veya cloud storage kullanılmaz.
# Tüm dosyalar backend sunucusunun disk'inde saklanır.
UPLOAD_DIR=backend/uploads

# ============================================================================
# FAISS VECTOR STORE
# ============================================================================
VECTOR_STORE_PATH=./data/vectors
FAISS_INDEX_OFFICIAL=vdb_official.index
VECTOR_DIMENSION=3072  # Google Gemini gemini-embedding-001 için 3072
VECTOR_SEARCH_K=5

# ============================================================================
# PDF İŞLEME
# ============================================================================
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=pdf
PDF_CHUNK_SIZE=512
PDF_CHUNK_OVERLAP=50

# ============================================================================
# VERİ SENKRONİZASYONU (Gelecekte kullanılabilir)
# ============================================================================
SYNC_ENABLED=false
SYNC_INTERVAL_HOURS=2
SYNC_START_HOUR=8
SYNC_END_HOUR=22
UZEM_API_URL=
UZEM_API_KEY=
ANNOUNCEMENTS_RSS_URL=
SCHEDULE_CSV_URL=

# ============================================================================
# GÜVENLİK
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=100
AI_RATE_LIMIT_PER_MINUTE=10

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================================================
# EMAIL (Mailhog Ayarları)
# ============================================================================
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@kampusplus.edu.tr
SMTP_FROM_NAME=KAMPÜS+ Platform
FRONTEND_URL=http://localhost:5173

# ============================================================================
# ÜNİVERSİTE ÖZEL AYARLAR - KAMPÜS+ GENEL
# ============================================================================
UNIVERSITY_NAME=Kampüs+ Türkiye  # "Konya" kısıtlamasını kaldırdık
SUPPORT_EMAIL=support@kampusplus.edu.tr

# 🚀 GÜNCELLEME: Artık 205 üniversiteyi desteklediğimiz için tek tek yazmak yerine 
# Eğer kodun bu listeye bakıyorsa, şimdilik boş bırakıp kodda ".edu.tr" kontrolü yapmak daha temizdir.
ALLOWED_EMAIL_DOMAINS=all_edu_tr