# KAMPÜS+ – copy to .env and set your values (never commit .env)

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_NAME=KAMPÜS+ AI Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# -----------------------------------------------------------------------------
# DATABASE
# Docker: DATABASE_URL is set by compose (PostgreSQL). Local: pick one.
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./kampus_plus_dev.db
# DATABASE_URL=postgresql+asyncpg://kampus:kampus@localhost:5432/kampus_plus

# -----------------------------------------------------------------------------
# JWT (required – generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER_ME=30

# -----------------------------------------------------------------------------
# GOOGLE GEMINI (required for AI – https://makersuite.google.com/app/apikey)
# -----------------------------------------------------------------------------
AI_PROVIDER=gemini
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=models/gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=8192

# -----------------------------------------------------------------------------
# FAISS VECTOR STORE
# -----------------------------------------------------------------------------
VECTOR_STORE_PATH=./data/vectors
FAISS_INDEX_OFFICIAL=vdb_official.index
FAISS_INDEX_USER=vdb_user.index
VECTOR_DIMENSION=768
VECTOR_SEARCH_K=5

# -----------------------------------------------------------------------------
# PDF
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=pdf
PDF_CHUNK_SIZE=512
PDF_CHUNK_OVERLAP=50

# -----------------------------------------------------------------------------
# SYNC (UZEM / RSS / CSV – optional)
# -----------------------------------------------------------------------------
SYNC_ENABLED=false
SYNC_INTERVAL_HOURS=2
SYNC_START_HOUR=8
SYNC_END_HOUR=22
UZEM_API_URL=
UZEM_API_KEY=
ANNOUNCEMENTS_RSS_URL=
SCHEDULE_CSV_URL=

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=100
AI_RATE_LIMIT_PER_MINUTE=10

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_METRICS=true
METRICS_PORT=9090

# -----------------------------------------------------------------------------
# EMAIL (optional – verification / password reset)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=KAMPÜS+ Platform
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# UNIVERSITY
# -----------------------------------------------------------------------------
UNIVERSITY_NAME=Konya Universities
SUPPORT_EMAIL=support@kampusplus.edu.tr
ALLOWED_EMAIL_DOMAINS=ogr.selcuk.edu.tr,ktun.edu.tr,ogr.erbakan.edu.tr,karatay.edu.tr,ogr.gidatarim.edu.tr
