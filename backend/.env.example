# KAMPÜS+ Backend — Örnek Ortam Değişkenleri
# Bu dosyayı kopyalayın: cp .env.example .env
# Ardından gerçek değerlerinizi girin.
# .env dosyası GIT'E EKLENMEMELİDİR (.gitignore'da zaten var).

# ============================================================================
# UYGULAMA
# ============================================================================
ENVIRONMENT=development
DEBUG=true

# ============================================================================
# VERİTABANI
# ============================================================================
# Lokal geliştirme için SQLite (kurulum gerektirmez):
DATABASE_URL=sqlite+aiosqlite:///./data/kampus_plus.db

# Uzak/prodüksiyon PostgreSQL için yukarıdaki satırı yorum yapıp aşağıdakini açın:
# DATABASE_URL=postgresql+asyncpg://kullanici:sifre@host:5432/kampus_plus

# ============================================================================
# JWT KİMLİK DOĞRULAMA
# ============================================================================
# Güvenli key üretmek için: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER_ME=30

# ============================================================================
# GOOGLE GEMINI API (GEREKLİ — AI asistan bu olmadan çalışmaz)
# ============================================================================
# API key almak için: https://aistudio.google.com/app/apikey
AI_PROVIDER=gemini
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=8192

# ============================================================================
# DOSYA DEPOLAMA — LOCAL STORAGE
# ============================================================================
# Bu proje S3/MinIO kullanmaz; dosyalar backend/uploads/ dizininde saklanır.
UPLOAD_DIR=backend/uploads

# ============================================================================
# FAISS VEKTÖR STORE
# ============================================================================
VECTOR_STORE_PATH=./data/vectors
FAISS_INDEX_OFFICIAL=vdb_official.index
FAISS_INDEX_USER=vdb_user.index
VECTOR_DIMENSION=3072
VECTOR_SEARCH_K=5

# ============================================================================
# PDF İŞLEME
# ============================================================================
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=pdf
PDF_CHUNK_SIZE=512
PDF_CHUNK_OVERLAP=50

# ============================================================================
# VERİ SENKRONİZASYONU (isteğe bağlı)
# ============================================================================
SYNC_ENABLED=false
SYNC_INTERVAL_HOURS=2
SYNC_START_HOUR=8
SYNC_END_HOUR=22
UZEM_API_URL=
UZEM_API_KEY=
ANNOUNCEMENTS_RSS_URL=
SCHEDULE_CSV_URL=

# ============================================================================
# GÜVENLİK & CORS
# ============================================================================
# Frontend'in çalıştığı tüm origin'leri buraya ekleyin (virgülle ayırın).
# Docker compose'da frontend port 5174'te çalışır.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:8001
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=100
AI_RATE_LIMIT_PER_MINUTE=10

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================================================
# EMAIL — Mailhog (lokal test) veya gerçek SMTP
# ============================================================================
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@kampusplus.edu.tr
SMTP_FROM_NAME=KAMPÜS+ Platform
FRONTEND_URL=http://localhost:5174

# ============================================================================
# ÜNİVERSİTE AYARLARI
# ============================================================================
UNIVERSITY_NAME=Kampüs+ Türkiye
SUPPORT_EMAIL=support@kampusplus.edu.tr
# Kayıt için izin verilen e-posta uzantısı (tüm .edu.tr adreslerine izin verir):
ALLOWED_EMAIL_DOMAINS=.edu.tr
