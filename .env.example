# ============================================================================
# KAMPÜS+ ENVIRONMENT VARIABLES
# ============================================================================
# Bu dosyayı backend/.env olarak kopyalayın ve değerleri doldurun
# Komut: cp .env.example backend/.env (macOS/Linux)
#         Copy-Item .env.example backend\.env (Windows)
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE
# ----------------------------------------------------------------------------
# Development için SQLite kullanıyoruz (dosya tabanlı, kolay)
# Production için PostgreSQL'e geçilecek
DATABASE_URL=sqlite+aiosqlite:///./kampus_plus_dev.db

# ----------------------------------------------------------------------------
# JWT (JSON Web Token) AUTHENTICATION
# ----------------------------------------------------------------------------
# JWT_SECRET_KEY: Token'ları şifrelemek için kullanılır
# ⚠️ DEVELOPMENT: Aşağıdaki key'i kullanabilirsiniz
# ⚠️ PRODUCTION: Güçlü, rastgele bir key oluşturun!
#    Python ile oluşturmak için: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-secret-key-change-in-production-use-python-secrets-module
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------------------------
# AI PROVIDER SELECTION
# ----------------------------------------------------------------------------
# Hangi AI sağlayıcısını kullanacağınızı seçin: "gemini" veya "openai"
# Önerilen: gemini (ücretsiz tier var)
AI_PROVIDER=gemini

# ----------------------------------------------------------------------------
# GOOGLE GEMINI API (Önerilen)
# ----------------------------------------------------------------------------
# API Key almak için: https://makersuite.google.com/app/apikey
# ⚠️ ZORUNLU: Kendi API key'inizi buraya yazın!
GOOGLE_API_KEY=your-gemini-api-key-here

# Gemini model ayarları (varsayılanlar iyi çalışıyor)
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048

# ----------------------------------------------------------------------------
# OPENAI API (Opsiyonel - Ücretli)
# ----------------------------------------------------------------------------
# Sadece OpenAI kullanacaksanız doldurun
# API Key almak için: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2048
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ----------------------------------------------------------------------------
# VECTOR STORE (FAISS)
# ----------------------------------------------------------------------------
# Vektör veritabanı ayarları (varsayılanları değiştirmeyin)
VECTOR_STORE_PATH=data/vectors
VECTOR_SEARCH_K=5

# ----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ----------------------------------------------------------------------------
# Frontend'in backend'e erişmesi için gerekli
# Frontend port'unuzu buraya ekleyin (genelde 3000 veya 5173)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----------------------------------------------------------------------------
# ENVIRONMENT
# ----------------------------------------------------------------------------
# development, staging, veya production
ENVIRONMENT=development

# ----------------------------------------------------------------------------
# AWS S3 (Opsiyonel - Gelecekte PDF upload için)
# ----------------------------------------------------------------------------
# Şimdilik boş bırakabilirsiniz
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=eu-central-1

# ----------------------------------------------------------------------------
# EMAIL (Opsiyonel - Email verification için)
# ----------------------------------------------------------------------------
# Şimdilik boş bırakabilirsiniz
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@kampusplus.com

# ============================================================================
# KURULUM SONRASI KONTROL LİSTESİ
# ============================================================================
# ✅ 1. Bu dosyayı backend/.env olarak kopyaladınız mı?
# ✅ 2. GOOGLE_API_KEY değerini kendi key'inizle değiştirdiniz mi?
# ✅ 3. JWT_SECRET_KEY'i production için değiştirecek misiniz? (dev için şimdilik ok)
# ✅ 4. CORS_ORIGINS'e frontend port'unuzu eklediniz mi?
# ============================================================================
